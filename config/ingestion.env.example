# ============================================================================
# Content Ingestion - Environment Variables
# ============================================================================
#
# Copy this file to .env.local and fill in your values.
# NEVER commit actual API keys or secrets to version control.
#
# Usage:
#   cp config/ingestion.env.example .env.local
#   # Edit .env.local with your actual values
#
# ============================================================================

# ============================================================================
# DATABASE & REDIS (Required)
# ============================================================================

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/envivo_studio

# Redis URL for caching and rate limiting
# Format: redis://host:port
REDIS_URL=redis://localhost:6379

# ============================================================================
# INNGEST (Required for background jobs)
# ============================================================================

# Inngest event key (from Inngest dashboard)
INNGEST_EVENT_KEY=

# Inngest signing key (from Inngest dashboard)
INNGEST_SIGNING_KEY=

# ============================================================================
# SYSTEM A: Calendar Events API Keys
# ============================================================================

# Ticketmaster Discovery API
# Get from: https://developer.ticketmaster.com/
# Free tier: 5,000 requests/day
TICKETMASTER_API_KEY=

# Eventbrite API
# Get from: https://www.eventbrite.com/developers/
# Apply for API access: https://www.eventbrite.com/platform/
EVENTBRITE_API_KEY=

# ============================================================================
# SYSTEM B: Content Feed API Keys
# ============================================================================

# NewsAPI - Breaking music news
# Get from: https://newsapi.org/
# Free tier: 100 requests/day, 10 requests/minute
# Note: Only works on localhost in free tier
NEWS_API_KEY=

# GNews - Alternative news source
# Get from: https://gnews.io/
# Free tier: 100 requests/day
GNEWS_API_KEY=

# ============================================================================
# TENANT CONFIGURATION
# ============================================================================

# Tandil tenant UUID
# Get from your database: SELECT id FROM tenants WHERE slug = 'tandil';
TANDIL_TENANT_ID=

# ============================================================================
# CONFIGURATION (Optional)
# ============================================================================

# Path to sources.yaml configuration file
# Default: config/sources.yaml
# SOURCES_CONFIG_PATH=config/sources.yaml

# ============================================================================
# DEVELOPMENT vs PRODUCTION
# ============================================================================

# Set to 'development' for local testing
# NODE_ENV=development

# ============================================================================
# LOGGING & DEBUGGING (Optional)
# ============================================================================

# Log level: debug | info | warn | error
# LOG_LEVEL=info

# Enable verbose API response logging (may contain sensitive data)
# LOG_API_RESPONSES=false

# ============================================================================
# BACKFILL SETTINGS (Optional)
# ============================================================================

# Default batch size for backfill operations
# BACKFILL_BATCH_SIZE=100

# Delay between batches in milliseconds
# BACKFILL_BATCH_DELAY_MS=1000

# ============================================================================
# MONITORING & ALERTING (Optional)
# ============================================================================

# Datadog API key for metrics (if using Datadog)
# DATADOG_API_KEY=

# Slack webhook URL for alerts
# SLACK_WEBHOOK_URL=

# PagerDuty integration key for critical alerts
# PAGERDUTY_KEY=

# ============================================================================
# RATE LIMITING (Optional overrides)
# ============================================================================

# Override global rate limit multiplier (1.0 = use config values)
# RATE_LIMIT_MULTIPLIER=1.0

# ============================================================================
# TESTING (Do not use in production)
# ============================================================================

# Set to 'true' to enable dry-run mode (no actual API calls)
# INGESTION_DRY_RUN=false

# Use mock data instead of real API responses
# INGESTION_USE_MOCKS=false
